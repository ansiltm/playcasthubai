{
  "name": "playcasthub-backend",
  "version": "1.0.0",
  "description": "Backend API for PlaycastHub Store",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test tests/security.test.cjs tests/netlify.test.cjs tests/product-colors.test.cjs",
    "test:integration": "npm run build && node --test tests/store.test.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "serverless-http": "3.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
